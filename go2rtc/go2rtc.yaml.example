# go2rtc configuration (Home Assistant add-on "go2rtc": /config/go2rtc.yaml)
#
# Replace every <PLACEHOLDER>. Use two DIFFERENT credential pairs:
#   - api:  for the go2rtc web UI / REST API (admin access, never give this to Protect)
#   - rtsp: only for RTSP consumers on the LAN (UniFi Protect). Avoid look-alike
#           characters (l/I/1, O/0) in this password: you will type it into Protect.
#
# Note: go2rtc does not require RTSP auth for clients connecting from localhost
# (127.0.0.1), e.g. Scrypted running on the same host with host networking.

api:
  listen: ":1984"
  username: <API_ADMIN_USER>
  password: <API_ADMIN_PASSWORD>

rtsp:
  listen: ":8554"
  username: <RTSP_USER>          # e.g. "rtspviewer"
  password: <RTSP_PASSWORD>
  default_query: video           # Protect only needs H.264 video; drops the AAC-ELD audio track

# Optional: low-latency H.264 preset for Apple Home via Scrypted.
# The E1 sends a keyframe only every ~6.7 s, so live view is slow to start.
# The *_hk streams below re-encode with a keyframe every 8 frames (~0.5 s).
# See docs/fast-live-view.md (CPU numbers, hardware acceleration).
ffmpeg:
  h264hk: "-c:v libx264 -g 8 -keyint_min 8 -sc_threshold 0 -bf 0 -profile:v main -level:v 4.0 -preset:v superfast -tune:v zerolatency -threads:v 1 -pix_fmt:v yuv420p -b:v 1500k -maxrate 2000k -bufsize 2000k"

streams:
  # "hass:<title>" reuses the HomeKit pairing that Home Assistant's
  # homekit_controller integration already has for the camera. <title> is the
  # title of the config entry (Settings > Devices & services > HomeKit Device),
  # e.g. "Camera-E1-XXXX".
  #
  # Fragment options (handled by go2rtc's HomeKit client):
  #   #maxwidth=1280  only pick native resolutions with width  <= 1280
  #   #maxheight=720  only pick native resolutions with height <= 720
  #   #bitrate=1M     request ~1 Mbit/s from the camera (default ~4 Mbit/s)
  # Both maxwidth AND maxheight are needed for 16:9; see README "Aspect ratio gotcha".

  # Camera on weak Wi-Fi: 1280x720 @ ~1 Mbit/s (no packet loss)
  camera1:
    - hass:<E1_CONFIG_ENTRY_TITLE_1>#maxwidth=1280#maxheight=720#bitrate=1M

  # Camera with good Wi-Fi: 1280x720 at the camera's default bitrate.
  # (Drop #maxwidth/#maxheight for native 1920x1080 if you do not transcode.)
  camera2:
    - hass:<E1_CONFIG_ENTRY_TITLE_2>#maxwidth=1280#maxheight=720

  camera3:
    - hass:<E1_CONFIG_ENTRY_TITLE_3>#maxwidth=1280#maxheight=720#bitrate=1M

  # Transcoded streams for Scrypted / Apple Home (short GOP, fast start).
  # Read from the streams above over loopback, so still ONE HomeKit session per
  # camera. Video is re-encoded, AAC-ELD audio is passed through.
  # Keep UniFi Protect on camera1/camera2/camera3.
  camera1_hk:
    - ffmpeg:camera1#video=h264hk
    - rtsp://127.0.0.1:8554/camera1?audio
  camera2_hk:
    - ffmpeg:camera2#video=h264hk
    - rtsp://127.0.0.1:8554/camera2?audio
  camera3_hk:
    - ffmpeg:camera3#video=h264hk
    - rtsp://127.0.0.1:8554/camera3?audio
